[Unit]
Description=Telegram FileToLink Bot API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/filetolink
EnvironmentFile=/opt/filetolink/.env
ExecStart=/opt/filetolink/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
